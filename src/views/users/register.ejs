<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <%- include('../partials/header') %>

    <main class="auth-page">

        <div class="auth-visual">
            <div class="auth-visual-copy">
                <h2>Empezá a diseñar con los mejores recursos</h2>
                <p>Creá tu cuenta y accedé al historial de compras, descargas y ofertas exclusivas.</p>
                <div class="auth-benefits">
                    <div class="benefit-item">
                        <span class="benefit-icon">✓</span>
                        <span>Descarga inmediata de todos tus recursos</span>
                    </div>
                    <div class="benefit-item">
                        <span class="benefit-icon">✓</span>
                        <span>Historial de compras y descargas siempre disponible</span>
                    </div>
                    <div class="benefit-item">
                        <span class="benefit-icon">✓</span>
                        <span>Acceso anticipado a nuevos productos</span>
                    </div>
                    <div class="benefit-item">
                        <span class="benefit-icon">✓</span>
                        <span>Descuentos exclusivos para miembros</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-form-panel">
            <div class="auth-form-inner">

                <h1 class="auth-title">Crear cuenta</h1>
                <p class="auth-subtitle">¿Ya tenés una? <a href="/users/login">Ingresá acá</a></p>

                <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                    <div class="login-error-banner">
                        <span>⚠</span>
                        <ul class="error-list">
                            <% errors.forEach(error => { %>
                                <li><%= error %></li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <form id="register-form" action="/users/register" method="POST" enctype="multipart/form-data" novalidate>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="firstName">Nombre *</label>
                            <input class="form-input" type="text" id="firstName" name="firstName"
                                   placeholder="Lucía"
                                   value="<%= typeof old !== 'undefined' ? old.firstName || '' : '' %>">
                            <span class="form-error" id="error-firstName"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="lastName">Apellido *</label>
                            <input class="form-input" type="text" id="lastName" name="lastName"
                                   placeholder="García"
                                   value="<%= typeof old !== 'undefined' ? old.lastName || '' : '' %>">
                            <span class="form-error" id="error-lastName"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="email">Correo electrónico *</label>
                        <input class="form-input" type="email" id="email" name="email"
                               placeholder="lucia@email.com"
                               value="<%= typeof old !== 'undefined' ? old.email || '' : '' %>">
                        <span class="form-error" id="error-email"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">Contraseña *</label>
                        <input class="form-input" type="password" id="password" name="password"
                               placeholder="Mínimo 8 caracteres">
                        <span class="form-error" id="error-password"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password2">Repetir contraseña *</label>
                        <input class="form-input" type="password" id="password2" name="password2"
                               placeholder="Repetí tu contraseña">
                        <span class="form-error" id="error-password2"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="image">Foto de perfil</label>
                        <input class="form-input" type="file" id="image" name="image"
                               accept="image/jpeg,image/png,image/webp,image/gif">
                        <span class="form-hint">JPG, PNG, WEBP o GIF — máx. 2MB. Opcional.</span>
                        <span class="form-error" id="error-image"></span>
                    </div>

                    <button type="submit" class="btn btn-accent btn-full btn-lg">Crear mi cuenta</button>

                </form>

            </div>
        </div>

    </main>

    <%- include('../partials/footer') %>
    <script src="/js/register.validate.js"></script>

</body>
</html>